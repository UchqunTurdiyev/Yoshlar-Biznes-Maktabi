# ============ SAYT ============
NEXT_PUBLIC_SITE_URL=https://ybm.uz
NEXT_PUBLIC_CONTACT_PHONE=+998 90 000 00 00
NEXT_PUBLIC_CONTACT_TELEGRAM=@yoshlarbiznesmaktabi

# ============ META (Pixel + Conversions API) ============
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Events Manager → Test events kodi (sinovdan keyin O‘CHIRING)
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v21.0
# Meta reklama akkaunti valyutasi. USD bo‘lsa, so‘m shu kurs bo‘yicha konvertatsiya qilinadi
META_CURRENCY=USD
META_UZS_RATE=12700

# ============ amoCRM ============
# Masalan: https://yourcompany.amocrm.ru
AMO_BASE_URL=
AMO_LONG_LIVED_TOKEN=
AMO_PIPELINE_ID=
AMO_STATUS_ID=
AMO_RESPONSIBLE_USER_ID=
# Lid kartasidagi "Viloyat" maxsus maydoni ID si (ixtiyoriy; bo‘lmasa izohga yoziladi)
AMO_REGION_FIELD_ID=
# Shu bosqich(lar)ga o‘tganda Metaga Purchase ketadi. 142 = "Успешно реализовано"
AMO_PURCHASE_STATUS_IDS=142
# Webhook URL: https://SAYT/api/amocrm/webhook?secret=SHU_QIYMAT
AMO_WEBHOOK_SECRET=

# ============ TELEGRAM ============
TELEGRAM_BOT_TOKEN=
# Bir nechta chat bo‘lsa vergul bilan: -1001234567890,123456789
TELEGRAM_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# ============ XAVFSIZLIK ============
# Kamida 10 belgi
ADMIN_PASSWORD=
# Kamida 32 belgi:  openssl rand -base64 48
SESSION_SECRET=
# Shaxsiy ma’lumotlarni shifrlash kaliti (O‘ZGARTIRMANG — eski lidlar o‘qilmay qoladi):  openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# ============ SAQLASH ============
# Vercel’da majburiy (Upstash Redis). VPS/Eskiz’da bo‘sh qoldirsangiz ./data/leads.json ishlatiladi
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATA_DIR=./data

# ============ NARXLAR (so‘m) ============
PRICE_GRANT_UZS=4800000
PRICE_FULL_UZS=16000000
